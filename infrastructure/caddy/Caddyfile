# Reverse proxy: one origin for the browser.
#   /api/*, /ws/*  -> backend (FastAPI)
#   everything else -> frontend (Next.js)
# TLS is terminated by Tailscale Serve in front of this (see docs/deployment.md),
# so Caddy only speaks plain HTTP on the private Docker network / loopback.
{
	admin off
	auto_https off
	servers {
		# Requests arrive from Tailscale Serve via Docker's port mapping (a private IP).
		trusted_proxies static private_ranges
	}
}

:80 {
	encode zstd gzip

	header {
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "same-origin"
		Cross-Origin-Opener-Policy "same-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
	}

	handle /caddy-health {
		respond "ok" 200
	}

	handle /api/* {
		reverse_proxy backend:8000
	}

	handle /ws/* {
		reverse_proxy backend:8000
	}

	handle {
		reverse_proxy frontend:3000
	}
}
