# moloko configuration. Copy to `.env` (never commit .env) and fill in the blanks.
# Generate each secret with:   openssl rand -hex 32

# --- Network --------------------------------------------------------------------
# Caddy listens here. Keep 127.0.0.1: Tailscale Serve forwards tailnet HTTPS to it.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# --- PostgreSQL ------------------------------------------------------------------
POSTGRES_DB=moloko
POSTGRES_USER=moloko
# Use a hex value (it is embedded in a connection URL).
POSTGRES_PASSWORD=

# --- Secrets ---------------------------------------------------------------------
# Signs CSRF tokens. At least 32 characters.
SECRET_KEY=
# Encrypts AI provider API keys stored in the database (needed from Sprint 2).
APP_ENCRYPTION_KEY=

# --- Sessions --------------------------------------------------------------------
SESSION_TTL_HOURS=168
# Keep true: Tailscale Serve provides HTTPS. Set false only for plain-http local testing.
COOKIE_SECURE=true

# --- HTTP ------------------------------------------------------------------------
# Comma-separated extra origins allowed to call the API with cookies. Empty = same origin.
CORS_ALLOWED_ORIGINS=

LOG_LEVEL=INFO

# --- Agent execution limits (spec 7.2) --------------------------------------------------
MAX_ACTIVE_SUBAGENTS_PER_RUN=5
MAX_SUBAGENT_DEPTH=2
MAX_STEPS_PER_RUN=50
RUN_TIMEOUT_SECONDS=1800
MAX_RETRIES_PER_STEP=2
MAX_PARALLEL_TOOL_CALLS=3
APPROVAL_TTL_MINUTES=60

# --- Memory (spec 17) ------------------------------------------------------------------
# Characters of saved memory put into one agent's prompt; size limit of one memory entry.
MEMORY_CONTEXT_MAX_CHARS=8000
MEMORY_ENTRY_MAX_CHARS=4000

# --- Backups (spec 21.3) ------------------------------------------------------------------
# Put this on ANOTHER disk (external drive / NAS mount), e.g. /mnt/backup/moloko.
BACKUP_DIR=./backups
BACKUP_HOUR=3
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# --- Tools and sandbox (spec 15, 16) ------------------------------------------------------
# Token between the worker and the sandbox runner (init-env.sh generates it).
SANDBOX_RUNNER_TOKEN=
# Group id of /var/run/docker.sock on the server (init-env.sh detects it).
DOCKER_GID=999
SANDBOX_IMAGE=python:3.12.16-slim
SANDBOX_CPUS=1
SANDBOX_MEMORY_MB=512
SANDBOX_PIDS_LIMIT=128
SANDBOX_TIMEOUT_SECONDS=60
# Programs agents may run (comma-separated; no shell, no network inside the sandbox).
# SANDBOX_ALLOWED_COMMANDS=python,pytest,ls,cat,grep,git
# Optional self-hosted SearXNG for web_search, e.g. http://searxng:8080 (empty = off).
SEARXNG_URL=
# Files of finished tasks' workspaces are deleted after this many days (0 = never).
WORKSPACE_TASK_TTL_DAYS=14

# --- Chat files ---------------------------------------------------------------------------
# Pictures go to vision models; PDF text is extracted on the server. Sizes in bytes.
CHAT_IMAGE_MAX_BYTES=5000000
CHAT_PDF_MAX_BYTES=10000000
# How many of a chat's latest pictures are sent to the model again with each question.
CHAT_CONTEXT_IMAGES=4

# --- Voice input and smart search (through your OpenAI provider) -------------------------
# Defaults; you can change the models in Settings → Voice & search.
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
VOICE_MAX_BYTES=10000000
# Search index: chunk size (characters) and results per search.
SEARCH_CHUNK_CHARS=1200
SEARCH_MAX_RESULTS=8

# --- Web Push (notifications while moloko is closed) ----------------------------------
# Contact the push services (Apple/Google/Mozilla) can reach you at: mailto:you@example.org
# or an https:// URL. Apple rejects placeholder addresses, so set a real one.
PUSH_CONTACT=mailto:owner@moloko.invalid
# How long a push service keeps an undelivered notification (seconds).
PUSH_TTL_SECONDS=86400

# --- GitHub MCP -------------------------------------------------------------------------
# The official GitHub MCP server (hosted by GitHub). Change only for GitHub Enterprise.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# --- AI providers ------------------------------------------------------------------
# Official API keys only (spec 13.5). Normally you add providers and keys in
# Settings → AI providers (stored encrypted). Keys here are a fallback for providers
# saved without their own key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_MAX_RETRIES=2
# Offline fake provider for demos/tests. Keep false on the real server.
ENABLE_MOCK_PROVIDER=false
