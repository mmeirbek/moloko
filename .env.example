# moloko configuration. Copy to `.env` (never commit .env) and fill in the blanks.
# Generate each secret with:   openssl rand -hex 32

# --- Network --------------------------------------------------------------------
# Caddy listens here. Keep 127.0.0.1: Tailscale Serve forwards tailnet HTTPS to it.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# --- PostgreSQL ------------------------------------------------------------------
POSTGRES_DB=moloko
POSTGRES_USER=moloko
# Use a hex value (it is embedded in a connection URL).
POSTGRES_PASSWORD=

# --- Secrets ---------------------------------------------------------------------
# Signs CSRF tokens. At least 32 characters.
SECRET_KEY=
# Encrypts AI provider API keys stored in the database (needed from Sprint 2).
APP_ENCRYPTION_KEY=

# --- Sessions --------------------------------------------------------------------
# How long a sign-in lasts by default (hours). You can pick your own value in
# Settings → Security (confirmed with your password), between the MIN and MAX below.
SESSION_TTL_HOURS=168
SESSION_TTL_MIN_HOURS=1
# At most 2160 (90 days).
SESSION_TTL_MAX_HOURS=2160
# Keep true: Tailscale Serve provides HTTPS. Set false only for plain-http local testing.
COOKIE_SECURE=true

# --- Passkeys (sign in with Face ID / Touch ID) -------------------------------------
# moloko's Tailscale name without https://, e.g. moloko.tail1234.ts.net, and the full
# address the browser shows, e.g. https://moloko.tail1234.ts.net (comma-separated if more).
# Both empty = passkeys off, the password only (e.g. on an http://127.0.0.1 test stack:
# passkeys need a real domain). init-env.sh fills them in from `tailscale status`.
WEBAUTHN_RP_ID=
WEBAUTHN_ORIGINS=

# --- Owner profile -------------------------------------------------------------------
# Longest form of address you can set ("how moloko addresses you", Settings or
# `python -m app.cli set-address`). It is put into every prompt that talks to you.
ADDRESS_AS_MAX_CHARS=80

# --- HTTP ------------------------------------------------------------------------
# Comma-separated extra origins allowed to call the API with cookies. Empty = same origin.
CORS_ALLOWED_ORIGINS=

LOG_LEVEL=INFO

# --- Agent execution limits (spec 7.2) --------------------------------------------------
MAX_ACTIVE_SUBAGENTS_PER_RUN=5
MAX_SUBAGENT_DEPTH=2
MAX_STEPS_PER_RUN=50
RUN_TIMEOUT_SECONDS=1800
MAX_RETRIES_PER_STEP=2
MAX_PARALLEL_TOOL_CALLS=3
APPROVAL_TTL_MINUTES=60
# Per-agent monthly budgets (agent page): warn at this percent of the agent's own limit.
AGENT_BUDGET_WARN_PERCENT=80
# Longest reply an agent's model may write in one step (tokens; code needs room), and how many
# cut-off replies in a row the agent may continue from before the task fails.
AGENT_MAX_OUTPUT_TOKENS=16000
AGENT_MAX_CUT_OFFS=3
# How many own agent templates ("Save as template") you can keep.
AGENT_TEMPLATES_MAX=50
# Agents talking to each other directly (tools agent_ask / agent_tell): minutes an agent
# waits for a colleague's answer, deepest chain A→B→C…, questions per task, size of one
# message (characters) and how many workspace files it may carry.
AGENT_ASK_TIMEOUT_MINUTES=30
AGENT_ASK_MAX_HOPS=3
AGENT_ASKS_PER_TASK=10
AGENT_MESSAGE_MAX_CHARS=20000
AGENT_MESSAGE_MAX_FILES=10

# --- Scheduled tasks ----------------------------------------------------------------------
# Most schedules per owner; shortest repeat (minutes, at least 60 = "every hour").
SCHEDULES_MAX_PER_USER=50
SCHEDULE_MIN_INTERVAL_MINUTES=60
# A due schedule whose agent is busy waits up to this long, then that run is skipped (0 = skip).
SCHEDULE_BUSY_WAIT_MINUTES=30
SCHEDULE_DUE_BATCH=20

# --- Memory (spec 17) ------------------------------------------------------------------
# Characters of saved memory put into one agent's prompt; size limit of one memory entry.
MEMORY_CONTEXT_MAX_CHARS=8000
MEMORY_ENTRY_MAX_CHARS=4000
# "Your recent work" in every agent's prompt: last finished tasks / characters (0 = off).
WORK_HISTORY_ITEMS=10
WORK_HISTORY_CONTEXT_CHARS=4000

# --- Backups (spec 21.3) ------------------------------------------------------------------
# Put this on ANOTHER disk (external drive / NAS mount), e.g. /mnt/backup/moloko.
BACKUP_DIR=./backups
BACKUP_HOUR=3
BACKUP_KEEP_DAILY=7
BACKUP_KEEP_WEEKLY=4

# --- Off-site copies (encrypted with restic; docs/deployment.md, section 6a) ----------------
# After every daily backup an encrypted copy leaves the laptop. Set ONE destination, then run
# infrastructure/scripts/offsite-init.sh. Both empty = off (nothing else changes).
#   Backblaze B2:  s3:https://s3.<region>.backblazeb2.com/<bucket>/moloko
#   Cloudflare R2: s3:https://<account id>.r2.cloudflarestorage.com/<bucket>/moloko
#   SFTP host:     sftp:<user>@<host>:/<path>/moloko  (key + known_hosts in OFFSITE_SSH_DIR)
OFFSITE_REPOSITORY=
# ...or an external disk mounted on this server, e.g. /mnt/moloko-offsite (not with the above).
OFFSITE_DISK=
# Encryption password (offsite-init.sh creates one). Without it NOBODY can open the copies —
# keep it, and the keys below, in your password manager too.
OFFSITE_PASSWORD=
# Access keys of the bucket (B2: keyID + applicationKey; R2: Access Key ID + Secret).
OFFSITE_S3_ACCESS_KEY_ID=
OFFSITE_S3_SECRET_ACCESS_KEY=
# Only if the provider needs it (R2: auto).
OFFSITE_S3_REGION=
# SFTP only: folder on this server with the private key and known_hosts for the host.
OFFSITE_SSH_DIR=
# How many off-site copies to keep (newest of each day / week / month).
OFFSITE_KEEP_DAILY=7
OFFSITE_KEEP_WEEKLY=4
OFFSITE_KEEP_MONTHLY=6
# Every N days: check the repository (reading this share of the data) and test-restore the
# newest copy into a scratch database. 0 = never (not recommended).
OFFSITE_CHECK_DAYS=7
OFFSITE_CHECK_SUBSET=10%
OFFSITE_DRILL_DAYS=7
# Upload speed limit in KiB/s, so backups do not fill your internet connection. 0 = no limit.
OFFSITE_UPLOAD_LIMIT_KIB=0

# --- Tools and sandbox (spec 15, 16) ------------------------------------------------------
# Token between the worker and the sandbox runner (init-env.sh generates it).
SANDBOX_RUNNER_TOKEN=
# Group id of /var/run/docker.sock on the server (init-env.sh detects it).
DOCKER_GID=999
SANDBOX_IMAGE=python:3.12.16-slim
SANDBOX_CPUS=1
SANDBOX_MEMORY_MB=512
SANDBOX_PIDS_LIMIT=128
SANDBOX_TIMEOUT_SECONDS=60
# Programs agents may run (comma-separated; no shell, no network inside the sandbox).
# SANDBOX_ALLOWED_COMMANDS=python,pytest,ls,cat,grep,git
# Optional self-hosted SearXNG for web_search, e.g. http://searxng:8080 (empty = off).
SEARXNG_URL=
# Files of finished tasks' workspaces are deleted after this many days (0 = never, default:
# the agents' work is kept; the task records themselves are always kept).
WORKSPACE_TASK_TTL_DAYS=0
# The agents' browser: its internal Docker network and the egress proxy's byte limit per connection.
BROWSER_NETWORK=moloko_browser
EGRESS_MAX_BYTES=30000000

# --- Chat files ---------------------------------------------------------------------------
# Any type, any size, any number of files. 0 = no limit (bytes per file / files per message).
CHAT_ATTACHMENT_MAX_BYTES=0
CHAT_ATTACHMENTS_PER_MESSAGE=0
# Uploads stop when the disk would have less free space than this (bytes).
CHAT_UPLOAD_MIN_FREE_BYTES=1000000000
# Characters of attached text put into one request to the model (cut text is marked).
CHAT_ATTACHMENT_PROMPT_MAX_CHARS=200000
# Pictures bigger than this go to the model as a smaller copy (the original is kept).
CHAT_IMAGE_MODEL_MAX_SIDE=1568
CHAT_IMAGE_MODEL_MAX_BYTES=3500000
# How many of a chat's latest pictures are sent to the model again with each question.
CHAT_CONTEXT_IMAGES=4

# --- Chat memory --------------------------------------------------------------------------
# A long chat never forgets: older messages are condensed into a summary kept on the server.
# CHAT_SUMMARY_MODEL = the name of one of your models (e.g. a cheaper one); empty = the chat's own.
CHAT_SUMMARY_ENABLED=true
CHAT_SUMMARY_MAX_CHARS=4000
CHAT_SUMMARY_MODEL=
CHAT_SUMMARY_INPUT_MAX_CHARS=30000
# Before answering, the best matches from your other chats, tasks and memory are given to the
# model as data (one quick search; skipped when it takes longer than the timeout).
CHAT_RECALL_ENABLED=true
CHAT_RECALL_TOP_K=5
CHAT_RECALL_MAX_CHARS=3000
CHAT_RECALL_TIMEOUT_SECONDS=2
CHAT_RECALL_TYPES=memory,attachment,task,chat_message,agent_message

# --- Voice input: local speech recognition (the `stt` service, no key needed) --------------
# Whisper on this server's CPU: small | medium | large-v3-turbo | large-v3.
# Downloaded once by the `stt-models` service; change it and run deploy.sh again.
STT_MODEL=large-v3-turbo
# CPU threads for the model and the container's CPU/memory limit.
STT_CPU_THREADS=6
STT_CPUS=6
STT_MEMORY=4g
# Languages auto-detection chooses from (comma-separated ISO codes; empty = any).
STT_LANGUAGES=ru,en
# Largest recording accepted (bytes; a 15-minute recording is ~15-25 MB).
VOICE_UPLOAD_MAX_BYTES=200000000
# Uncomment to switch the local model off (voice then needs an OpenAI provider):
# STT_URL=

# --- Smart search, and voice when the local model is off (through your OpenAI provider) ---
# Defaults; you can change the models in Settings → Voice & search.
TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Search index: chunk size (characters) and results per search.
SEARCH_CHUNK_CHARS=1200
SEARCH_MAX_RESULTS=8
# Work history in search (tasks, agent messages, chat messages): items per indexing pass
# and chunks per item.
WORK_INDEX_BATCH=100
WORK_INDEX_MAX_CHUNKS=20

# --- Web Push (notifications while moloko is closed) ----------------------------------
# Contact the push services (Apple/Google/Mozilla) can reach you at: mailto:you@example.org
# or an https:// URL. Apple rejects placeholder addresses, so set a real one.
PUSH_CONTACT=mailto:owner@moloko.invalid
# How long a push service keeps an undelivered notification (seconds).
PUSH_TTL_SECONDS=86400

# --- GitHub MCP -------------------------------------------------------------------------
# The official GitHub MCP server (hosted by GitHub). Change only for GitHub Enterprise.
GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/

# --- AI providers ------------------------------------------------------------------
# Official API keys only (spec 13.5). Normally you add providers and keys in
# Settings → AI providers (stored encrypted). Keys here are a fallback for providers
# saved without their own key.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PROVIDER_TIMEOUT_SECONDS=120
PROVIDER_MAX_RETRIES=2
# Offline fake provider for demos/tests. Keep false on the real server.
ENABLE_MOCK_PROVIDER=false
