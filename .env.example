# Ключ Claude API: https://platform.claude.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-...

# Пароль для входа в офис с телефона. Обязателен в продакшене.
APP_PASSWORD=придумайте-длинный-пароль

# Случайная строка для подписи сессий (например: openssl rand -hex 32).
# Без неё после каждого перезапуска придётся входить заново.
SESSION_SECRET=

# Модель по умолчанию для всех агентов (у каждого можно переопределить в «Команде»).
MODEL=claude-opus-5-5

# Предохранитель расходов: после этой суммы за сутки новые задачи не запускаются.
DAILY_BUDGET_USD=10

# Сколько запросов к модели может идти одновременно.
MAX_PARALLEL=4

# Максимум шагов (запросов к модели) в одной задаче.
MAX_TURNS=40

# Где хранить базу (на хостинге — путь к постоянному диску).
DATA_DIR=./data
