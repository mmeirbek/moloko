# ===== Чем платить за работу агентов (нужно одно из двух) =====

# Вариант 1 — подписка Claude Pro/Max. Токен получают один раз на любом компьютере:
#   npx @anthropic-ai/claude-code setup-token   (вход вашим аккаунтом, токен действует год)
# Важно: используйте только сами; см. раздел «Подписка Pro» в README.
CLAUDE_CODE_OAUTH_TOKEN=

# Вариант 2 — ключ Claude API: https://platform.claude.com/settings/keys
# (в подписках Max/Team включены ежемесячные API-кредиты — их можно привязать к ключу).
ANTHROPIC_API_KEY=

# Если заданы оба — по умолчанию используется подписка. Чтобы платить ключом: CLAUDE_AUTH=api
# CLAUDE_AUTH=api

# ===== Доступ к офису =====

# Пароль для входа с телефона. Обязателен в продакшене.
APP_PASSWORD=придумайте-длинный-пароль

# Случайная строка для подписи сессий (например: openssl rand -hex 32).
SESSION_SECRET=

# ===== Ограничения =====

# Сколько отделов работают одновременно. Каждый — отдельный процесс Claude Code (~300 МБ памяти).
MAX_PARALLEL=3

# Разрешить агентам Bash (выполняет любые команды на сервере!). По умолчанию выключено.
# ALLOW_BASH=1

# Максимум шагов координатора в одной задаче.
MAX_TURNS=60

# Только для API-ключа: после этой суммы за сутки новые задачи не запускаются.
DAILY_BUDGET_USD=10

# Где хранить базу и диск офиса (на хостинге — путь к постоянному диску).
DATA_DIR=./data
