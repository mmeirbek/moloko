# Local development settings for running the API on the host (`uv run uvicorn ...`).
# Copy to apps/api/.env. Use the POSTGRES_PASSWORD from the root .env.
ENVIRONMENT=development
LOG_LEVEL=INFO
DATABASE_URL=postgresql+asyncpg://moloko:CHANGE_ME@127.0.0.1:5432/moloko
REDIS_URL=redis://127.0.0.1:6379/0
SECRET_KEY=dev-only-secret-key-change-me-0123456789abcdef
# Plain http on localhost:
COOKIE_SECURE=false
