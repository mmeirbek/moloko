{
  "name": "peter-office",
  "version": "0.1.0",
  "description": "Виртуальный офис ИИ-агентов, управляемый с телефона",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node --disable-warning=ExperimentalWarning dist/server.js",
    "typecheck": "tsc --noEmit"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mmeirbek/peter.git"
  },
  "bugs": {
    "url": "https://github.com/mmeirbek/peter/issues"
  },
  "homepage": "https://github.com/mmeirbek/peter#readme",
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.300",
    "@anthropic-ai/sdk": "0.135.0",
    "express": "4.21.2",
    "yaml": "2.8.1",
    "zod": "4.1.12"
  },
  "devDependencies": {
    "@types/express": "4.17.23",
    "@types/node": "22.18.0",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  },
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "main": "dist/server.js"
}
